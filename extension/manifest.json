{
  "manifest_version": 3,
  "name": "Disney+ Edge Enhanced",
  "version": "0.5.0",
  "description": "Disney+のフルHD要求をON/OFF。右クリックからIntel向け4Kと診断を選択。Intel内蔵GPUで約5分の4K再生を確認。環境依存。",
  "minimum_chrome_version": "111",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "action": {
    "default_title": "Disney+ Edge Enhanced — クリックでフルHD ON/OFF"
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "DisneyPlus-Edge-Enhanced.user.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
