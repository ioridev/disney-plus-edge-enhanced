{
  "manifest_version": 3,
  "name": "Disney+ Edge Enhanced",
  "version": "0.3.16",
  "description": "Disney+の画質・PlayReady再生を検証する実験用拡張。1080p短時間再生を確認、4K未達。DRMは回避しません。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "DisneyPlus-Edge-Enhanced.user.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
